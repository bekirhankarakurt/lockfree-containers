# Doxygen configuration for the lfc API reference.
# Run from the repository root: doxygen docs/Doxyfile
PROJECT_NAME           = "lockfree-containers"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Header-only lock-free containers for C++17"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = include/lfc README.md
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
EXCLUDE_SYMBOLS        = lfc::detail
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO
SOURCE_BROWSER         = YES
STRIP_FROM_PATH        = .
